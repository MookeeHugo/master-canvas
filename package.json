{
  "name": "master-canvas",
  "version": "2.0.0",
  "description": "Master Canvas — local-first pre-production canvas for AI video planning",
  "author": "BloomReel Team",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "node scripts/smoke.js",
    "smoke:installer:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-smoke.ps1 -Package nsis",
    "smoke:installer:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-smoke.ps1 -Package msi",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "vite build && tauri build --no-bundle",
    "tauri:installer": "vite build && tauri build --bundles nsis",
    "tauri:msi": "vite build && tauri build --bundles msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "vite": "^6.2.0"
  }
}
